{
  "name": "wxt-starter",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "description": "__TODO__",
  "keywords": [
    "wxt"
  ],
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "compile": "vue-tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "release": "bumpp",
    "typecheck": "vue-tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@ntnyq/utils": "^0.23.0",
    "@unocss/reset": "^66.10.5",
    "@vueuse/core": "^15.0.0",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "webext-bridge": "^6.0.1"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.22",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/i18n": "^0.2.7",
    "@wxt-dev/module-vue": "^1.0.3",
    "@wxt-dev/unocss": "^1.0.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "unplugin-vue-components": "^32.1.0",
    "vue-tsc": "^3.3.12",
    "wxt": "^0.21.4"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,svg,yml,yaml,toml,json}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
