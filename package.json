{
  "name": "x-video-downloader",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "description": "Download videos from X with quality selection",
  "keywords": [
    "wxt"
  ],
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "compile": "vue-tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "release": "bumpp",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@lucide/vue": "^1.54.0",
    "@ntnyq/utils": "^0.23.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-vue": "^1.0.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.72.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vue-tsc": "^3.3.12",
    "wxt": "^0.21.4"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,svg,yml,yaml,toml,json}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
