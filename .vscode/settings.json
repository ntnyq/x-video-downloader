{
  "oxc.enable": true,
  "eslint.enable": true,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never",
    "source.sortImports": "never"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "eslint.validate": [
    "vue",
    "xml",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "js/ts.experimental.useTsgo": false,
  "cSpell.allowCompoundWords": true,
  "cSpell.words": [
    "bumpp",
    "changelogithub",
    "clsx",
    "cmdk",
    "cmfa",
    "cmfv",
    "dtrace",
    "esbuild",
    "EXTM",
    "fastly",
    "ftyp",
    "iconify",
    "IDBP",
    "lucide",
    "mdat",
    "mdia",
    "minf",
    "moof",
    "moov",
    "mvex",
    "nocheck",
    "nums",
    "nuxt",
    "ofetch",
    "OPFS",
    "oxfmt",
    "oxfmtrc",
    "oxlint",
    "pinia",
    "pscp",
    "pssh",
    "reka",
    "remux",
    "remuxer's",
    "remuxing",
    "saio",
    "saiz",
    "Segoe",
    "senc",
    "shadcn",
    "sonner",
    "stbl",
    "stsd",
    "traf",
    "trak",
    "transmuxer",
    "twimg",
    "uniquified",
    "uniquify",
    "unplugin",
    "unrs",
    "VITE",
    "vueuse",
    "WCAG"
  ]
}
